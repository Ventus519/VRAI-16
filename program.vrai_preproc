const enable = q1
const out = 0x8012
const out_ctrl = 0x8010
const in = 0x8002
const in_ctrl = 0x8000
const io = q13
const disk_nr = q8
const source = q9
const dest = q10
const spare = q11
const temp = q5
addi enable, zr, 0x0001
jmp START
IN:
str_h [zr+in_ctrl], enable

ld_w io, [zr+in]

str_h [zr+in_ctrl], zr

ld_w COND, [sp+0x8000]
addi sp, sp, 2
jmpr COND
OUT:
str_w [zr+out], io

str_h [zr+out_ctrl], enable

str_h [zr+out_ctrl], zr

ld_w COND, [sp+0x8000]
addi sp, sp, 2
jmpr COND
START:
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp IN
addi disk_nr, io, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp IN
addi source, io, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp IN
addi dest, io, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp IN
addi spare, io, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp MOVE
HALT

MOVE:
subi sp, sp, 2
str_w [sp+0x8000], spare
subi sp, sp, 2
str_w [sp+0x8000], dest
subi sp, sp, 2
str_w [sp+0x8000], source
subi sp, sp, 2
str_w [sp+0x8000], disk_nr
subi sp, sp, 2
str_w [sp+0x8000], temp
cmpi disk_nr, 0x0000

jne SETUP

addi io, source, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi io, zr, 0x0005
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi io, dest, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi io, zr, 0x0005
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
jmp CLEANUP

SETUP:
subi disk_nr, disk_nr, 0x0001

addi temp, spare, 0
addi spare, dest, 0
addi dest, temp, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp MOVE
addi io, source, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi io, zr, 0x0005
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi io, spare, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi io, zr, 0x0005
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp OUT
addi dest, spare, 0
addi spare, source, 0
addi source, temp, 0
count [+16] COND
subi sp, sp, 2
str_w [sp+0x8000], COND
jmp MOVE
CLEANUP:
ld_w temp, [sp+0x8000]
addi sp, sp, 2
ld_w disk_nr, [sp+0x8000]
addi sp, sp, 2
ld_w source, [sp+0x8000]
addi sp, sp, 2
ld_w dest, [sp+0x8000]
addi sp, sp, 2
ld_w spare, [sp+0x8000]
addi sp, sp, 2
ld_w COND, [sp+0x8000]
addi sp, sp, 2
jmpr COND
